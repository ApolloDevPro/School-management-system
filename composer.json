{
  "name": "ssms/school-management",
  "description": "Secondary School Management System",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "dompdf/dompdf": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "SSMS\\": "backend/"
    },
    "classmap": [
      "backend/core/",
      "backend/controllers/",
      "backend/models/",
      "backend/lib/",
      "backend/config/"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('vendor/autoload.php') || copy('vendor/dompdf/dompdf/lib/php-font-lib/src/FontLib/Autoloader.php', 'vendor/dompdf/dompdf/lib/php-font-lib/src/FontLib/Autoloader.php');\""
    ]
  }
}
