# SSMS Environment Configuration
# Copy this file to .env and fill in your production values
# NEVER commit .env to version control

# Database
DB_HOST=127.0.0.1
DB_NAME=ssms
DB_USER=root
DB_PASS=

# Application
APP_NAME=SSMS
APP_TAGLINE=Secondary School Management System
APP_TIMEZONE=Africa/Kampala
APP_URL=http://localhost/school%20mgt%20system

# Security
SESSION_SECURE=0
SESSION_HTTPONLY=1
CSRF_REGENERATE_ON_LOGIN=1

# Mail (SMTP) - optional, falls back to PHP mail()
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME=SSMS
SMTP_FROM_ADDRESS=no-reply@localhost

# SMS Gateway - optional
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=SSMS
SMS_GATEWAY_URL=
SMS_DEFAULT_LANGUAGE=en